@page "/payroll-runs/executions/{Id:guid}"
@layout MobileShellLayout
@using BamboeUp.Mobile.Modules.Services
@using Shared.DataTransferObjects
@inject PayrollRunApi Api

<div class="me-page">
    <div class="mh-section-head">
        <div class="me-head-row">
            <div class="mh-section-title"><h2>Result</h2></div>
            <a class="me-refresh" href="@(_execution is null ? "/payroll-runs" : $"/payroll-runs/{_execution.ProcessDefinitionGuid}")">Back</a>
        </div>
        <p class="mh-section-sub">@(_execution?.ExecutionNo ?? "Payroll Run")</p>
    </div>

    @if (_loading)
    {
        <p class="me-status">Loading...</p>
    }
    else if (_execution is null)
    {
        <div class="me-card"><p class="me-empty">@_error ?? "Execution was not found."</p></div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="me-warn">@_error</p>
        }
        <div class="me-card">
            <header class="me-card-top"><h3>@(_execution.Result?.ResultStatus ?? _execution.Status)</h3></header>
            <dl>
                <div><dt>Message</dt><dd>@Show(_execution.Result?.ResultMessage)</dd></div>
                <div><dt>Total</dt><dd>@(_execution.Result?.TotalRecords ?? 0)</dd></div>
                <div><dt>Success</dt><dd>@(_execution.Result?.SuccessRecords ?? 0)</dd></div>
                <div><dt>Warning</dt><dd>@(_execution.Result?.WarningRecords ?? 0)</dd></div>
                <div><dt>Failed</dt><dd>@(_execution.Result?.FailedRecords ?? 0)</dd></div>
            </dl>
        </div>

        <h3 class="mh-section-title">Messages</h3>
        <div class="me-list">
            @foreach (var item in _messages)
            {
                <div class="me-card">
                    <h3>@item.Severity</h3>
                    <p class="me-status">@item.Message</p>
                </div>
            }
            @if (_messages.Count == 0)
            {
                <div class="me-card"><p class="me-empty">No messages.</p></div>
            }
        </div>

        <h3 class="mh-section-title">Details</h3>
        <div class="me-list">
            @foreach (var item in _details)
            {
                <div class="me-card">
                    <h3>@Show(item.RecordLabel)</h3>
                    <p class="me-status">@item.Severity — @item.Message</p>
                </div>
            }
            @if (_details.Count == 0)
            {
                <div class="me-card"><p class="me-empty">No result rows.</p></div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProcessExecutionDto? _execution;
    private readonly List<ProcessMessageDto> _messages = [];
    private readonly List<ProcessResultDetailDto> _details = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _messages.Clear();
        _details.Clear();
        try
        {
            _execution = await Api.GetExecutionAsync(Id);
            if (_execution is null)
                return;
            _messages.AddRange(await Api.GetMessagesAsync(Id));
            _details.AddRange(await Api.GetResultDetailsAsync(Id));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
