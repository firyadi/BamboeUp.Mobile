@page "/employees"
@layout MobileShellLayout
@using BamboeUp.Mobile.Modules.Services
@using Shared.DataTransferObjects
@inject EmployeeApi Api

<div class="me-page">
    <div class="mh-section-head">
        <div class="me-head-row">
            <div class="mh-section-title"><h2>Employee</h2></div>
            <div class="me-head-actions">
                <a class="me-refresh" href="/forms">Form</a>
                <a class="me-new" href="/employees/new">New</a>
                <button type="button" class="me-refresh" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
            </div>
        </div>
        <p class="mh-section-sub">Mobile-04. Master Detail</p>
    </div>

    @if (_loading)
    {
        <p class="me-status">Loading...</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="me-warn">@_error</p>
        }
        <div class="me-list">
            @foreach (var item in _items)
            {
                <a class="me-card" href="@($"/employees/{item.EmployeeGuid}")">
                    <header class="me-card-top"><h3>@Show(item.PersonName)</h3></header>
                    <dl>
                        <div><dt>Employee No</dt><dd>@item.EmployeeNo</dd></div>
                        <div><dt>Hire Date</dt><dd>@item.HireDate.ToString("dd MMM yyyy")</dd></div>
                        <div><dt>Status</dt><dd>@Show(item.EmploymentStatusName)</dd></div>
                    </dl>
                </a>
            }
        </div>
        @if (_items.Count == 0)
        {
            <div class="me-card"><p class="me-empty">No records yet.</p></div>
        }
    }
</div>

@code {
    private readonly List<EmployeeDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items.Clear();
            _items.AddRange(await Api.GetListAsync());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
