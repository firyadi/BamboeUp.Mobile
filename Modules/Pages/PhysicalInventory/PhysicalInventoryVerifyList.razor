@page "/physical-inventory/verify"
@layout MobileShellLayout
@using BamboeUp.Mobile.Shell.Services
@using Shared.DataTransferObjects
@inject MobileAuthService Auth
@inject IPhysicalInventoryApi Api

<div class="me-page">
    <div class="mh-section-head">
        <div class="mh-section-title"><h2>Pending Verification</h2></div>
        <p class="mh-section-sub">Online only. A verifier cannot approve their own capture.</p>
    </div>

    @if (!Auth.CanVerifyPhysicalInventory)
    {
        <div class="me-card"><p class="me-status">Verification requires an online session and InventoryVerifier rights.</p></div>
    }
    else if (_loading)
    {
        <p class="me-status">Loading...</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="me-warn">@_error</p>
        }
        <div class="me-list">
            @foreach (var item in _items)
            {
                <a class="me-card" href="@($"/physical-inventory/verify/{item.PhysicalInventoryCaptureGuid}")">
                    <h3>@item.DocumentNumber / page @item.PageNumber</h3>
                    <p class="me-status">@item.CaptureStatus · counter @item.CounterUserId</p>
                </a>
            }
        </div>
        @if (_items.Count == 0)
        {
            <div class="me-card"><p class="me-empty">No captures waiting.</p></div>
        }
    }
</div>

@code {
    private readonly List<PhysicalInventoryCaptureDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.CanVerifyPhysicalInventory)
        {
            _loading = false;
            return;
        }

        try
        {
            _items.AddRange(await Api.GetQueueAsync());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
