@page "/work-notices"
@layout MobileShellLayout
@using BamboeUp.Mobile.Modules.Services
@using Shared.DataTransferObjects
@inject WorkNoticeApi Api

<div class="me-page">
    <div class="mh-section-head">
        <div class="me-head-row">
            <div class="mh-section-title"><h2>Work Notice</h2></div>
            <div class="me-head-actions">
                <a class="me-refresh" href="/forms">Form</a>
                <a class="me-new" href="/work-notices/new">New</a>
                <button type="button" class="me-refresh" @onclick="LoadAsync" disabled="@_loading">Refresh</button>
            </div>
        </div>
        <p class="mh-section-sub">Mobile-01. 1 Table</p>
    </div>

    @if (_loading)
    {
        <p class="me-status">Loading...</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="me-warn">@_error</p>
        }
        <div class="me-list">
            @foreach (var item in _items)
            {
                <a class="me-card" href="@($"/work-notices/{item.WorkNoticeGuid}")">
                    <header class="me-card-top"><h3>@item.WorkNoticeName</h3></header>
                    <dl>
                        <div><dt>Work Notice Code</dt><dd>@item.WorkNoticeCode</dd></div>
                        <div><dt>Work Notice Date</dt><dd>@item.WorkNoticeDate.ToString("dd-MM-yyyy HH:mm")</dd></div>
                        <div><dt>Edit Able</dt><dd>@(item.IsEditAble ? "Yes" : "No")</dd></div>
                        <div><dt>Note</dt><dd>@Show(item.Note)</dd></div>
                    </dl>
                </a>
            }
        </div>
        @if (_items.Count == 0)
        {
            <div class="me-card"><p class="me-empty">No work notice data found.</p></div>
        }
    }
</div>

@code {
    private readonly List<WorkNoticeDto> _items = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items.Clear();
            _items.AddRange(await Api.GetListAsync());
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
